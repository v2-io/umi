#!/usr/bin/env ruby
# Crash with uncaught exception after random work
# Usage: crasher [max_lines]
# Processes 0 to max_lines inputs then crashes

max_lines   = (ARGV[0] || 3).to_i
crash_after = rand(0..max_lines)
$stdout.sync = true
$stderr.sync = true

count      = 0
while line = $stdin.gets
  count += 1
  sleep rand * 0.02
  puts "processed: #{line}"

  next unless count >= crash_after

  warn "FATAL: something went wrong!"
  sleep rand * 0.05
  raise "Simulated crash after #{count} lines"
end

# If stdin closes before crash point
raise "Simulated crash on EOF" if rand < 0.5
