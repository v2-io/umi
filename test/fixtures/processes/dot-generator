#!/usr/bin/env ruby
# Generates random DOT graphs for testing with graphviz
# Usage: dot-generator [node_count] [edge_density]
# Output: DOT language to stdout

node_count = (ARGV[0] || 5).to_i
edge_density = (ARGV[1] || 0.3).to_f
$stdout.sync = true

# Generate node names
nodes = (1..node_count).map { |i| "node#{i}" }

puts "digraph G {"
puts "  rankdir=LR;"

# Random node attributes
nodes.each do |node|
  shape = %w[box ellipse diamond].sample
  color = %w[red blue green orange purple].sample if rand < 0.3
  attrs = ["shape=#{shape}"]
  attrs << "color=#{color}" if color
  puts "  #{node} [#{attrs.join(', ')}];"
end

# Random edges based on density
nodes.each do |from|
  nodes.each do |to|
    next if from == to
    if rand < edge_density
      label = rand < 0.5 ? " [label=\"#{rand(1..100)}\"]" : ""
      puts "  #{from} -> #{to}#{label};"
    end
  end
end

puts "}"
