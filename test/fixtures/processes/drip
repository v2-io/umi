#!/usr/bin/env ruby
# Drip - outputs lines with irregular timing
# Usage: drip [count] [base_interval]
# Intervals vary: base * (0.5 to 1.5)

count = (ARGV[0] || 5).to_i
base = (ARGV[1] || 0.3).to_f
$stdout.sync = true
$stderr.sync = true

count.times do |i|
  interval = base * (0.5 + rand)
  sleep interval

  # Occasionally write to stderr instead
  if rand < 0.2
    $stderr.puts "drip #{i + 1} (stderr)"
  else
    puts "drip #{i + 1}"
  end
end
