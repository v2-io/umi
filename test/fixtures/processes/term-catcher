#!/usr/bin/env ruby
# Catches SIGTERM, does cleanup, exits gracefully
# Usage: term-catcher
# Runs until killed, echoes input, handles TERM gracefully

$stdout.sync = true
$stderr.sync = true
@running = true

Signal.trap("TERM") do
  warn "[#{$$}] caught SIGTERM, cleaning up..."
  sleep rand * 0.3  # Simulate cleanup
  warn "[#{$$}] cleanup done, exiting"
  @running = false
end

puts "[#{$$}] started, send SIGTERM to stop gracefully"

while @running
  next unless IO.select([$stdin], nil, nil, 0.1)

  line = $stdin.gets
  break unless line

  sleep rand * 0.02
  puts "echo: #{line}"
end

exit 0
